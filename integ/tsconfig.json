{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": [
      "es2022",
      "esnext.disposable"
    ],
    "skipLibCheck": true,
    "strict": true,
    "alwaysStrict": true,
    "declaration": true,
    "inlineSourceMap": true,
    "inlineSources": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "composite": true,
    "incremental": true
  },
  "exclude": [
    "**/cdk.out",
    "**/node_modules"
  ],
  "include": [
    "**/*.ts"
  ],
  "references": [
    {
      "path": "../packages/aws-rfdk"
    }
  ]
}
